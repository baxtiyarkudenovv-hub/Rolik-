 "subs": [
  [
   7.35,
   10.791,
   "Aksiyadorlik tijorat Xalq banki o‘z mijozlarini"
  ],
  [
   10.741,
   14.614,
   "kiberxavfsizlikdan himoya qilish uchun ogohlantiradi!"
  ],
  [
   15.914,
   18.805,
   "Kiberfiribgarlikning eng keng tarqalgan"
  ],
  [
   18.755,
   22.009,
   "usullaridan biri — smartfonga zararli dastur"
  ],
  [
   21.959,
   25.286,
   "o‘rnatib, ma’lumotlarni o‘g‘irlashga urinish."
  ],
  [
   25.236,
   28.272,
   "Odatda, foydalanuvchi qurilmasida zararli"
  ],
  [
   28.222,
   30.821,
   "dastur borligini bilmay ham qoladi."
  ],
  [
   31.921,
   36.674,
   "Bunday xavfning oldini olish maqsadida, Bankning operativ kuzatuv"
  ],
  [
   36.624,
   40.869,
   "va frod monitoringi bo‘limi xodimlari Antifrod tizimlarini"
  ],
  [
   40.819,
   45.065,
   "barqaror ishlash holatida saqlaydi, mijozlarga firibgarlik"
  ],
  [
   45.015,
   48.971,
   "holatlarining ko‘payishi bo‘yicha tushuntirish beradi."
  ],
  [
   50.071,
   54.392,
   "Xalq bankining Xazna mobil ilovasida maxsus antifrod tizimi"
  ],
  [
   54.342,
   58.301,
   "ishga tushirilgan bo‘lib, qurilmada shubhali dasturlar"
  ],
  [
   58.251,
   62.789,
   "aniqlansa, bu haqida darhol xabar beradi va xavfsizlik chorasi"
  ],
  [
   62.739,
   66.336,
   "sifatida ayrim amaliyotlarni vaqtincha cheklaydi."
  ],
  [
   67.636,
   70.514,
   "Agar siz Xazna mobil ilovasi orqali pul"
  ],
  [
   70.464,
   73.923,
   "o‘tkazmoqchi bo‘lsangiz va sizda zararli dastur"
  ],
  [
   73.873,
   77.114,
   "aniqlansa, ilova sizni darhol ogohlantiradi."
  ],
  [
   78.364,
   81.691,
   "Virusni o‘chirib tashlash uchun ekranda paydo"
  ],
  [
   81.641,
   85.186,
   "bo‘lgan «Muammoni hal qilish» tugmasini bosasiz."
  ],
  [
   85.136,
   87.224,
   "Tizim sizni zararli dasturni"
  ],
  [
   87.174,
   89.7,
   "boshqarish sahifasiga olib o‘tadi."
  ],
  [
   90.65,
   93.811,
   "Ushbu sahifadagi ilova ishlamasa, «Ruxsatni"
  ],
  [
   93.761,
   96.343,
   "olib tashlash» funksiyasini yoqing."
  ],
  [
   97.293,
   100.876,
   "So‘ng pastdagi «Olib tashlash» tugmasini bosasiz."
  ],
  [
   100.826,
   104.986,
   "Shundan so‘ng zararli dastur telefoningizdan o‘chiriladi."
  ],
  [
   105.736,
   109.997,
   "Xazna mobil ilovasining yana bir afzalligi shundaki, tizim"
  ],
  [
   109.947,
   114.208,
