 "subs": [
  {
   "a": 13.2,
   "b": 21.342,
   "s": "Bul estelik S. P. Tolstov basshılıǵındaǵı Xorezm arxeologiya hám etnografiya ekspediciyası tárepinen"
  },
  {
   "a": 21.692,
   "b": 25.065,
   "s": "XX ásirdiń 50–60-jıllarında anıqlanǵan"
  },
  {
   "a": 25.415,
   "b": 29.558,
   "s": "hám 1946-jılı arxeologiyalıq kartaǵa túsirilgen."
  },
  {
   "a": 33.108,
   "b": 39.404,
   "s": "Eń dáslep «Bul estelik ne ushın Buǵraxan dep atalǵan?» degen soraw tuwıladı."
  },
  {
   "a": 39.754,
   "b": 47.204,
   "s": "Maǵlıwmatlarda esteliktiń atı 992-jılı Mawarannaxrdı iyelegen Qaraxaniyler áwladınan bolǵan"
  },
  {
   "a": 47.554,
   "b": 52.158,
   "s": "Buǵraxannıń atı menen baylanıslı ekenligi kórsetiledi."
  },
  {
   "a": 52.508,
   "b": 59.881,
   "s": "Sonday-aq, Buǵraxan qalası Xorezmshahlar mámleketiniń orayı bolǵan degen boljawlar da bar."
  },
  {
   "a": 63.431,
   "b": 67.804,
   "s": "Estelikte saqlanǵan minara XI ásirden derek beredi."
  },
  {
   "a": 68.154,
   "b": 72.065,
   "s": "Esteliktiń ulıwma maydanı 60 gektardan aslam."
  },
  {
   "a": 72.415,
   "b": 79.404,
   "s": "Maǵlıwmatlar bul jerdiń bir waqıtları úlken civilizaciya orayı bolǵanlıǵın kórsetedi."
  },
  {
   "a": 82.954,
   "b": 86.404,
   "s": "Minara tariyxta qanday xızmet atqarǵan?"
  },
  {
   "a": 86.754,
   "b": 92.127,
   "s": "Boljawlarǵa qaraǵanda, ol xabar beriw ornı bolǵan bolıwı múmkin."
  },
  {
   "a": 92.477,
   "b": 97.619,
   "s": "Minaranıń átirapı jámiyetlik orın bolǵan degen juwmaq ta bar."
  },
  {
   "a": 97.969,
   "b": 104.112,
   "s": "Orta ásirlerde Xorezm minaralarınıń qurılısında ulıwmalıq belgiler bolǵan."
  },
  {
   "a": 104.462,
   "b": 109.527,
   "s": "Olar biyik, dóńgelek bolıp, joqarı qaray jińishkerip barǵan."
  },
  {
   "a": 109.877,
   "b": 117.712,
   "s": "Buǵraxan minarasınıń biyikligi haqqında anıq maǵlıwmat joq. Bul haqqında tek boljawlar aytıladı."
  },
  {
   "a": 121.262,
   "b": 125.635,
   "s": "Minaralar qurılısı jaǵınan hár túrli bolıwı múmkin."
  },
  {
   "a": 125.985,
   "b": 133.896,
   "s": "Musılman xalıqlarınıń tariyxında minaralar tiykarınan namaz oqıytuǵın orın sıpatında qollanılǵan."
  },
  {
   "a": 134.246,
   "b": 140.158,
   "s": "Buǵraxan qalası Xorezmshahlar mámleketiniń arqa shegarasında jaylasqan."
  },
  {
   "a": 140.508,
   "b": 145.65,
   "s": "Izertlewler qalanıń úsh bólimnen ibarat bolǵanlıǵın kórsetti."
  },
  {
   "a": 146,
   "b": 149.988,
   "s": "Onıń oraylıq bóliminde qala meshiti jaylasqan."
  },
  {
   "a": 150.338,
   "b": 155.481,
   "s": "Buǵraxan minarası Xorezmshahlar dáwirine tán usılda qurılǵan."
  },
  {
   "a": 159.031,
   "b": 166.25,
   "s": "Bul jerlerdi birneshe márte suw basqanına qaramastan, Buǵraxan minarası saqlanıp qalǵan."
  },
  {
   "a": 166.6,
   "b": 171.588,
   "s": "Bul onıń qanshelli sheberlik penen qurılǵanlıǵın kórsetedi."
  },
  {
   "a": 175.138,
   "b": 180.896,
   "s": "Buǵraxan esteligin úyreniw jumısları birneshe basqıshta alıp barıldı."
  },
  {
   "a": 181.246,
   "b": 188.465,
   "s": "Ózbekstan Respublikası Prezidentiniń 2025-jılı qabıl etilgen 248-sanlı qararına muwapıq,"
  },
  {
   "a": 188.815,
   "b": 197.65,
   "s": "jańa arxeologiyalıq orınlardı úyreniw hám jańa turistlik baǵdarlardı jolǵa qoyıw wazıypaları belgilengen edi."
  },
  {
   "a": 198,
   "b": 207.758,
   "s": "Usı tapsırmaǵa muwapıq, Berdaq atındaǵı Qaraqalpaq mámleketlik universitetiniń arxeologiya kafedrası qánigeleri tárepinen"
  },
  {
   "a": 208.108,
   "b": 214.25,
   "s": "Buǵraxan esteligin qayta tiklew hám abadanlastırıw jumısları alıp barıldı."
  },
  {
   "a": 214.6,
   "b": 222.973,
   "s": "Burın eski qalalardıń qazıp úyrenilgen orınları jumıslar tamamlanǵannan keyin qaytadan jabılatuǵın edi."
  },
  {
   "a": 223.323,
   "b": 228.312,
   "s": "Bul sayaxatshılardıń itibarın tartıwǵa kesent etetuǵın edi."
  },
  {
   "a": 228.662,
   "b": 235.342,
   "s": "Endi Buǵraxan esteligin qısı-jazı kóriw hám zıyarat etiw múmkinshiligi jaratıldı."
  },
  {
   "a": 238.892,
   "b": 247.265,
   "s": "Úlkemiz aymaǵınan tabılǵan hám úyrenilip atırǵan bul qalalar bir juwmaq shıǵarıwǵa múmkinshilik beredi."
  },
  {
   "a": 247.615,
   "b": 253.527,
   "s": "Olardıń qurılısında tereń bilim, bay tájiriybe hám sheberlik jámlengen."
  },
  {
   "a": 253.877,
   "b": 261.404,
   "s": "Demek, biz jasap atırǵan aymaq orta ásirlerde ilim-bilim rawajlanǵan oraylardıń biri bolǵan."
  },
  {
   "a": 264.954,
   "b": 274.019,
   "s": "Qońırat rayonı aymaǵında jaylasqan, XI–XIV ásirlerge tiyisli bul estelikti úyreniw jumısları ele de dawam etedi."
  },
  {
   "a": 274.369,
   "b": 281.435,
   "s": "Onıń qatlamlarında ele de talay maǵlıwmatlar hám biybaha derekler bar ekenligi sózsiz."
  }
 ],
